# Copy this file to .env.local and set only the values you need.
# CANVAS_GATEWAY_HOST=127.0.0.1
# CANVAS_GATEWAY_PORT=4174
# Local-network development (HTTP; private IP addresses only):
# CANVAS_VITE_HOST=0.0.0.0
# CANVAS_GATEWAY_HOST=0.0.0.0
# CANVAS_ALLOW_INSECURE_LAN=true
# CANVAS_PUBLIC_ORIGIN=http://192.168.1.10:4173
# CANVAS_ALLOWED_ORIGINS=http://192.168.1.10:4173
# Public collaboration requires all three settings below.
# CANVAS_GATEWAY_HOST=0.0.0.0
# CANVAS_PUBLIC_ORIGIN=https://canvas.example.com
# CANVAS_ALLOWED_ORIGINS=https://canvas.example.com
# CANVAS_DATA_DIR=./data
# CANVAS_GENERATION_MAX_RUN_TIME_MS=1800000
# CANVAS_DOH_ENDPOINT=https://your-doh-resolver.example/dns-query
API_PROVIDER_AISTARTLAB_KEY=
