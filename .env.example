# Copy this file to .env.local and set only the values you need.
# CANVAS_GATEWAY_HOST=127.0.0.1
# CANVAS_GATEWAY_PORT=4174
# Local-network development (HTTP; private IP addresses only):
# CANVAS_VITE_HOST=0.0.0.0
# CANVAS_GATEWAY_HOST=0.0.0.0
# CANVAS_ALLOW_INSECURE_LAN=true
# CANVAS_PUBLIC_ORIGIN=http://192.168.1.10:4173
# CANVAS_ALLOWED_ORIGINS=http://192.168.1.10:4173
# Public collaboration requires all three settings below.
# CANVAS_GATEWAY_HOST=0.0.0.0
# CANVAS_PUBLIC_ORIGIN=https://canvas.example.com
# CANVAS_ALLOWED_ORIGINS=https://canvas.example.com
# CANVAS_DATA_DIR=./data
# CANVAS_GENERATION_MAX_RUN_TIME_MS=1800000
# CANVAS_DOH_ENDPOINT=https://your-doh-resolver.example/dns-query
# Optional: the first remote-sharing download uses standard HTTP_PROXY / HTTPS_PROXY / NO_PROXY.
# Use your own proxy address only if required by your network; leave unset for direct access.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
# Optional: use an existing cloudflared installation instead of downloading.
# CLOUDFLARED_PATH=
# AI Provider API Keys (Set here or configure securely in-app; keys are only accessed server-side)
API_PROVIDER_AISTARTLAB_KEY=
# API_PROVIDER_MINIMAX_KEY=
# API_PROVIDER_OPENAI_KEY=
# API_PROVIDER_VOLCENGINE_KEY=
# API_PROVIDER_RUNNINGHUB_KEY=
# API_PROVIDER_MODELSCOPE_KEY=
# API_PROVIDER_KLING_KEY=
# API_PROVIDER_DASHSCOPE_KEY=
# API_PROVIDER_JIMENG_KEY=
# API_PROVIDER_COMFYUI_URL=http://127.0.0.1:8188

# Opt in new Agent tasks to registered canvas commands and immutable Skill v2.
# Rollback to 1 affects new tasks only; persisted v2 tasks retain their executor.
# CANVAS_AGENT_RUNTIME_VERSION=2
