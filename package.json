{
  "name": "libtv-canvas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:service": "node scripts/dev-service.mjs start",
    "dev:status": "node scripts/dev-service.mjs status",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "server": "node server/main.ts",
    "start": "node server/main.ts --production",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run src",
    "test:server": "vitest run server --maxWorkers=1",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lib0": "^0.2.117",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
