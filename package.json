{
  "name": "continuum",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcmmsmztchbfx-ctrl/Continuum-canvas.git"
  },
  "version": "0.0.0",
  "description": "Continuum 连点成片 - 基于 React Flow 的无限 AI 影视创作画布与专业矢量设计系统",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:service": "node scripts/dev-service.mjs start",
    "dev:status": "node scripts/dev-service.mjs status",
    "dev:stop": "node scripts/dev-service.mjs stop",
    "server": "node server/main.ts",
    "start": "node server/main.ts --production",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "licenses:update": "node scripts/third-party-notices.mjs",
    "test": "vitest run src",
    "test:server": "vitest run server --maxWorkers=1",
    "test:watch": "vitest src",
    "test:performance": "vitest run src/components/canvas/CanvasWorkspace.test.tsx src/components/canvas/media-node-performance.test.tsx src/collaboration/session.test.ts -t \"performance gate|node drag rendering\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:nightly": "playwright test tests/e2e/nightly",
    "test:e2e:visual": "playwright test tests/e2e/visual",
    "test:e2e:update-visual": "playwright test tests/e2e/visual --update-snapshots",
    "test:nightly": "npm run test:e2e:nightly && npm run test:e2e:visual",
    "test:all": "npm run lint && npm test && npm run test:server && npm run test:performance && npm run test:e2e:smoke",
    "preview": "vite preview",
    "test:performance:browser": "playwright test -c playwright.performance.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lib0": "^0.2.117",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "0.35.5",
    "undici": "^7.30.1",
    "ws": "^8.21.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
